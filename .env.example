# Copy to .env for local runs. Never commit .env.
GROQ_API_KEY=
PINECONE_API_KEY=
# Optional: the index host, saves one lookup per cold start
PINECONE_HOST=

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=alert2playbook

# Optional: lock live runs on your own Groq key behind a code (sent in the X-Demo-Code
# header). When it is set, everyone else runs live with their own model key instead
# (X-LLM-Key). Leave empty to keep runs open on GROQ_API_KEY.
A2P_DEMO_CODE=

# Shared store for rate limits and the run log behind the dashboard (Upstash Redis).
# Adding Upstash from the Vercel dashboard sets KV_REST_API_URL and KV_REST_API_TOKEN
# instead, which also work. Without either, limits and the log live in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Owner dashboard at /admin. Run `python scripts/make_admin.py` to fill these in.
A2P_ADMIN_USER=
A2P_ADMIN_PASSWORD_HASH=
A2P_ADMIN_SESSION_SECRET=
# Makes key and visitor fingerprints impossible to reverse. Any long random string.
A2P_FINGERPRINT_SECRET=

# Model per agent (defaults shown)
# A2P_TRIAGE_MODEL=qwen/qwen3.8-27b
# A2P_MAPPER_MODEL=openai/gpt-oss-20b
# A2P_WRITER_MODEL=openai/gpt-oss-120b
# A2P_CRITIC_MODEL=qwen/qwen3.8-27b
# A2P_FALLBACK_MODEL=openai/gpt-oss-120b
# A2P_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
